{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot - InveniqApplication",
      "request": "launch",
      "mainClass": "com.inveniq.InveniqApplication",
      "projectName": "inveniq-backend",
      "cwd": "${workspaceFolder}/backend-java"
    },
    {
      "name": "Python - FastAPI Analytics Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "jinja": true,
      "cwd": "${workspaceFolder}/backend-python"
    }
  ]
}
